# Alamat API Laravel, dibaca lewat import.meta.env.VITE_API_URL.
# Salin file ini menjadi .env lalu sesuaikan.
#
# - Pengembangan lokal (npm run dev, Laravel di port 8000):
VITE_API_URL=http://localhost:8000/api
#
# - Di dalam Docker Compose, nilainya "/api" (diatur lewat build arg di
#   frontend/Dockerfile); Nginx meneruskan /api ke service "backend".
