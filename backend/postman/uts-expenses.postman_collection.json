                "{{expense_id}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Makan malam\",\n  \"amount\": 22000,\n  \"category\": \"Makan\",\n  \"spent_on\": \"2026-10-20\",\n  \"note\": \"Kantin\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Judul berubah', () => pm.expect(pm.response.json().data.title).to.eql('Makan malam'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Hapus (200)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
