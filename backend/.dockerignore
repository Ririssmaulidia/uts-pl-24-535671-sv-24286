# Dipasang ulang di dalam image lewat composer install.
vendor
node_modules

# Riwayat Git dan berkas pengembangan tidak dibutuhkan di dalam container.
.git
.gitignore
.github
.idea
.vscode
*.log

# Rahasia dan konfigurasi lokal: JANGAN ikut masuk ke image.
.env
.env.*

# Database/cache lokal dibuat ulang di dalam container.
database/*.sqlite
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*.php

# Bukan bagian aplikasi yang dijalankan.
tests
postman
phpunit.xml
Dockerfile
Dockerfile.*
.dockerignore
