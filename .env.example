# Salin file ini menjadi ".env" (jangan di-commit) lalu isi nilainya.
#   Windows PowerShell : copy .env.example .env
#
# ── Kunci aplikasi Laravel (RAHASIA) ──────────────────────────
# Buat dengan perintah (butuh Docker saja, tanpa PHP/Laravel di laptop):
#   docker run --rm php:8.4-cli-alpine php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=

# ── Basis data MySQL (RAHASIA) ────────────────────────────────
DB_DATABASE=uts_db
DB_USERNAME=uts_user
DB_PASSWORD=ganti_dengan_password_kuat
DB_ROOT_PASSWORD=ganti_dengan_password_root_kuat

# ── Pengguna demo untuk login (dibuat otomatis oleh seeder) ───
SEED_USER_EMAIL=mahasiswa@example.com
SEED_USER_PASSWORD=password123

# ── Port di laptop (ubah bila bentrok dengan aplikasi lain) ───
BACKEND_PORT=8000
FRONTEND_PORT=8080
